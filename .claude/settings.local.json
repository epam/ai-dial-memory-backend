{
  "permissions": {
    "allow": [
      "WebFetch(domain:habr.com)",
      "Bash(bd --version)",
      "Bash(bd ready:*)",
      "Bash(bd list:*)",
      "Bash(bd show:*)",
      "Bash(bd update:*)",
      "Bash(bd remember:*)",
      "Bash(bd lint:*)",
      "Bash(bd create:*)",
      "Bash(bd close:*)",
      "Bash(python -m pytest tests/test_rest_integration.py -v)",
      "Bash(python -m pytest tests/test_rest_integration.py tests/test_api_router.py tests/test_memory_router.py -v)",
      "Bash(python -m pytest tests/test_app_module.py -v)",
      "Bash(python -m pytest tests/test_main.py -v)",
      "Bash(python -m pytest tests/test_exception_handler.py -v)",
      "Bash(python -m pytest tests/test_exception_handler.py tests/test_rest_integration.py tests/test_memory_router.py -v)",
      "Bash(python -m pytest tests/test_storage_sync_logging.py -v)",
      "Bash(python -m pytest tests/test_request_id_middleware.py -v)",
      "WebFetch(domain:docs.dialx.ai)",
      "Bash(python -c \"from mcp.server.fastmcp import Context; help\\(Context\\)\")",
      "Bash(python -m pytest src/tests/ -q)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python -m pytest src/tests/test_memory_service.py::test_abstract_memory_service_is_abstract -v)",
      "Bash(python -m pytest --tb=short -q)",
      "Bash(python -m pytest src/tests/test_storage_module.py -v)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          },
          {
            "type": "command",
            "command": "echo 'WORKFLOW REMINDER: Invoke template-bridge:unified-workflow before any task. Flow: bd create → brainstorm → plan → TDD → review → verify → finish → bd close'"
          }
        ]
      }
    ]
  }
}
